# Copy to .env and fill in. .env is gitignored.

# --- Gemini (required) ---
GEMINI_API_KEY=your-gemini-api-key-here
GENERATION_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- SEC EDGAR (required header per SEC fair-access policy) ---
EDGAR_USER_AGENT=Your Name finance-rag your-email@example.com
EDGAR_TICKERS=NVDA,AAPL,MSFT

# --- Retrieval tuning ---
CONFIDENCE_THRESHOLD=0.68
TOP_K_DENSE=10
TOP_K_SPARSE=10
FINAL_K=6

# --- Reranker (optional, needs sentence-transformers) ---
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Vector store: local (default) | supabase ---
VECTOR_STORE=local
# SUPABASE_URL=
# SUPABASE_KEY=
# SUPABASE_TABLE=filing_chunks
